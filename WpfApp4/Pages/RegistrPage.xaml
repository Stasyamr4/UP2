<Page x:Class="WpfApp4.Pages.RegistrPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp4.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegistrPage">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FF96B1DC"/>
                <GradientStop Color="#FF9AE6A9" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="МАГАЗИН ОДЕЖДЫ" Margin="0,0,0,20" HorizontalAlignment="Center"></TextBlock>
            <TextBlock Text="Регистрация" Margin="0,0,0,20" HorizontalAlignment="Center"></TextBlock>
            <TextBlock Text="Введите ваше ФИО" Margin="0,0,0,10" HorizontalAlignment="Center"></TextBlock>
            <TextBox x:Name="FIO" ToolTip="Введите ФИО"></TextBox>
            <TextBlock Text="Введите логин" Margin="0,0,0,10" HorizontalAlignment="Center"></TextBlock>
            <TextBox x:Name="Login" ToolTip="Введите логин"></TextBox>
            <TextBlock Text="Введите пароль" Margin="0,0,0,10" HorizontalAlignment="Center"></TextBlock>
            <PasswordBox x:Name="Password" ToolTip="Введите пароль"></PasswordBox>
            <TextBlock Text="Подтвердите пароль" Margin="0,0,0,10" HorizontalAlignment="Center"></TextBlock>
            <PasswordBox x:Name="PasswordProverka" ToolTip="Введите пароль"></PasswordBox>

            <Button x:Name="Registrbutton" Width="200" Height="30" Margin="0,20,0,0" Content="Зарегистрироваться" Click="Registrbutton_Click"></Button>
        </StackPanel>
    </Grid>
</Page>
