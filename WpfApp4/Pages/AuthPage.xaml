<Page x:Class="WpfApp4.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp4.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFDEACAC"/>
                <GradientStop Color="#FF730E0E" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="МАГАЗИН ОДЕЖДЫ" Margin="0,0,0,20" HorizontalAlignment="Center"></TextBlock>
            <TextBlock Text="АВТОРИЗАЦИЯ" Margin="0,0,0,20" HorizontalAlignment="Center"></TextBlock>
            <TextBlock Text="Введите логин" Margin="0,0,0,10" HorizontalAlignment="Center"></TextBlock>
            <TextBox x:Name="Login" ToolTip="Введите логин"></TextBox>
            <TextBlock Text="Введите пароль" Margin="0,0,0,10" HorizontalAlignment="Center"></TextBlock>
            <PasswordBox x:Name="Password" ToolTip="Введите пароль"></PasswordBox>

            <Button x:Name="Enter" Width="200" Height="30" Margin="0,20,0,0" Content="ВХОД" Click="Enter_Click"></Button>
            <Button x:Name="EnterReg" Width="200" Height="30" Margin="0,20,0,0" Content="Нет аккаунта? Зарегистрируйтесь" Background="Transparent" Click="EnterReg_Click"></Button>
        </StackPanel>
    </Grid>
</Page>
